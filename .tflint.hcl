# The README promises tflint with the AWS ruleset, so enable it here. Without
# this file tflint only runs the bundled terraform ruleset.

config {
  call_module_type = "local"
}

plugin "terraform" {
  enabled = true
  preset  = "recommended"
}

plugin "aws" {
  enabled = true
  version = "0.50.0"
  source  = "github.com/terraform-linters/tflint-ruleset-aws"
}
